// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  DRAFT
  MATCHING
  PENDING
  REASSIGNING
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  PAYMENT_PROCESSING
  PAID
  RATED
  DISPUTED
  CLOSED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
}

enum NotificationType {
  BOOKING_CREATED
  WORKER_MATCHED
  WORKER_ACCEPTED
  WORKER_DECLINED
  WORKER_EN_ROUTE
  WORKER_ARRIVED
  JOB_COMPLETED
  PAYMENT_RECEIVED
  MATCHING_FAILED
  PROMOTION
}

enum NotificationChannel {
  PUSH
  SMS
  WEBSOCKET
  IN_APP
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  TIMEOUT
}

model User {
  id           String         @id @default(uuid())
  phoneNumber  String         @unique
  name         String?
  role         Role           @default(CUSTOMER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  // Relations
  workerProfile     WorkerProfile?
  bookings          Booking[]              @relation("CustomerBookings")
  reviews           Review[]               @relation("CustomerReviews")
  notificationPrefs NotificationPreference?
  notifications     Notification[]
}

model WorkerProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          String[]       // Array of skills/services offered
  ratePerHour     Float
  experienceYears Int            @default(0)
  isVerified      Boolean        @default(false)
  isOnline        Boolean        @default(false)
  currentLat      Float?
  currentLng      Float?
  rating          Float          @default(0.0)
  reviewCount     Int            @default(0)
  responseRate    Float          @default(100.0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  bookings         Booking[]         @relation("WorkerBookings")
  reviews          Review[]          @relation("WorkerReviews")
  matchingAttempts MatchingAttempt[]
}

model ServiceCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  nameHi    String    // Vernacular name in Hindi
  iconName  String    // Vector icon name
  basePrice Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  bookings  Booking[]
}

model Booking {
  id             String          @id @default(uuid())
  customerId     String
  customer       User            @relation("CustomerBookings", fields: [customerId], references: [id])
  workerId       String?
  worker         WorkerProfile?  @relation("WorkerBookings", fields: [workerId], references: [id])
  categoryId     String
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  status         BookingStatus   @default(PENDING)
  description    String?
  address        String
  latitude       Float
  longitude      Float
  estimatedHours Float?
  totalAmount    Float
  scheduledAt    DateTime?       @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  review           Review?           @relation("BookingReview")
  payments         Payment[]
  matchingAttempts MatchingAttempt[]
}

model Review {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  booking    Booking       @relation("BookingReview", fields: [bookingId], references: [id])
  customerId String
  customer   User          @relation("CustomerReviews", fields: [customerId], references: [id])
  workerId   String
  worker     WorkerProfile @relation("WorkerReviews", fields: [workerId], references: [id])
  stars      Int           // 1-5 stars
  comment    String?
  createdAt  DateTime      @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  amount        Float
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled      Boolean  @default(true)
  smsEnabled       Boolean  @default(true)
  bookingAlerts    Boolean  @default(true)
  paymentAlerts    Boolean  @default(true)
  promotionAlerts  Boolean  @default(false)
  quietHoursStart  Int?
  quietHoursEnd    Int?
  fcmToken         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id      String              @id @default(uuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String
  body    String
  data    Json?
  channel NotificationChannel
  isRead  Boolean             @default(false)
  sentAt  DateTime            @default(now())
  readAt  DateTime?
}

model MatchingAttempt {
  id            String        @id @default(uuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  workerId      String
  worker        WorkerProfile @relation(fields: [workerId], references: [id])
  score         Float
  distanceKm    Float
  status        MatchStatus   @default(PENDING)
  sentAt        DateTime      @default(now())
  respondedAt   DateTime?
  declineReason String?
}
